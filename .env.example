# ============================================================
# Medical Knowledge Assistant — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# ----- PubMed / NCBI -----
PUBMED_EMAIL=your_email@example.com   # required by NCBI E-utilities

# ----- UMLS -----
UMLS_API_KEY=                          # get from https://uts.nlm.nih.gov/uts/signup-login

# ----- OpenFDA (optional — increases rate limit) -----
OPENFDA_API_KEY=

# ----- Neo4j -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medkg_password

# ----- Qdrant -----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                        # only needed if Qdrant auth is enabled
QDRANT_COLLECTION=med_kg_chunks

# ----- OpenAI -----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ----- Ollama (local LLM fallback) -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ----- Tavily -----
TAVILY_API_KEY=tvly-...

# ----- Cohere -----
COHERE_API_KEY=

# ----- Application -----
LOG_LEVEL=INFO
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
WEB_SEARCH_STALENESS_DAYS=180
